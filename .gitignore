# macOS
.DS_Store
**/.DS_Store

# 含敏感真人資料的檔案（身分證、薪資、聯絡資料）
*.csv
*.docx
*.xlsx
*.xls

# 個人 prompt 筆記
coach-mode-prompt*.md

# 本地暫存 / 編輯器
.vscode/
.idea/
*.swp
*.swo
*.local

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 建置產物（zeabur 會自己重 build，repo 不需要）
培訓web/dist/
培訓web/.cache/

# 環境變數（含 Supabase keys）
.env
.env.local
.env.*.local

# ── 除錯／截圖工作殘渣（非專案資產，可隨時刪）───────────────────
# Playwright MCP 執行紀錄
.playwright-mcp/
# 開發過程的截圖與量測 dump（根目錄）
/*.png
/*.json
# 一次性資料匯入腳本的中間產物（腳本本身若要保留，見 scripts/README）
scripts/*.json
scripts/*.txt
scripts/__pycache__/
